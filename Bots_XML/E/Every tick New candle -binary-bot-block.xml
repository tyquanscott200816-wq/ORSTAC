<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">

  <!-- VARIABLES -->
  <variables>
    <variable id="odd_count">odd_count</variable>
    <variable id="stake">stake</variable>
    <variable id="base_stake">base_stake</variable>
    <variable id="martingale">martingale</variable>
    <variable id="take_profit">take_profit</variable>
    <variable id="stop_loss">stop_loss</variable>
  </variables>

  <!-- TRADE PARAMETERS -->
  <block type="trade" id="trade" x="10" y="10">
    <field name="MARKET">synthetic_index</field>
    <field name="SYMBOL">R_10</field>
    <field name="TRADETYPE">DIGITEVEN</field>
    <field name="DURATIONTYPE">t</field>
    <field name="DURATION">1</field>
    <field name="AMOUNTTYPE">stake</field>
    <value name="AMOUNT">
      <block type="variables_get">
        <field name="VAR">stake</field>
      </block>
    </value>
  </block>

  <!-- INITIALIZE -->
  <block type="variables_set" x="10" y="150">
    <field name="VAR">base_stake</field>
    <value name="VALUE">
      <block type="math_number">
        <field name="NUM">1</field>
      </block>
    </value>
    <next>
      <block type="variables_set">
        <field name="VAR">stake</field>
        <value name="VALUE">
          <block type="variables_get">
            <field name="VAR">base_stake</field>
          </block>
        </value>
        <next>
          <block type="variables_set">
            <field name="VAR">martingale</field>
            <value name="VALUE">
              <block type="math_number">
                <field name="NUM">1.5</field>
              </block>
            </value>
            <next>
              <block type="variables_set">
                <field name="VAR">odd_count</field>
                <value name="VALUE">
                  <block type="math_number">
                    <field name="NUM">0</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>

  <!-- TICK ANALYSIS -->
  <block type="tick" x="300" y="10">
    <statement name="TICK">
      
      <!-- CHECK IF ODD -->
      <block type="controls_if">
        <value name="IF0">
          <block type="math_modulo">
            <value name="DIVIDEND">
              <block type="last_digit"></block>
            </value>
            <value name="DIVISOR">
              <block type="math_number">
                <field name="NUM">2</field>
              </block>
            </value>
          </block>
        </value>

        <!-- ODD -->
        <statement name="DO0">
          <block type="variables_set">
            <field name="VAR">odd_count</field>
            <value name="VALUE">
              <block type="math_arithmetic">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR">odd_count</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </statement>

        <!-- EVEN -->
        <statement name="ELSE">
          <block type="variables_set">
            <field name="VAR">odd_count</field>
            <value name="VALUE">
              <block type="math_number">
                <field name="NUM">0</field>
              </block>
            </value>
          </block>
        </statement>
      </block>

      <!-- ENTRY CONDITION -->
      <block type="controls_if">
        <value name="IF0">
          <block type="logic_compare">
            <field name="OP">GTE</field>
            <value name="A">
              <block type="variables_get">
                <field name="VAR">odd_count</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number">
                <field name="NUM">2</field>
              </block>
            </value>
          </block>
        </value>

        <statement name="DO0">
          <block type="purchase">
            <field name="CONTRACT">DIGITEVEN</field>
          </block>
        </statement>
      </block>

    </statement>
  </block>

  <!-- AFTER TRADE -->
  <block type="after_trade" x="600" y="10">
    <statement name="AFTER">

      <!-- IF WIN -->
      <block type="controls_if">
        <value name="IF0">
          <block type="result_win"></block>
        </value>
        <statement name="DO0">
          <block type="variables_set">
            <field name="VAR">stake</field>
            <value name="VALUE">
              <block type="variables_get">
                <field name="VAR">base_stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set">
                <field name="VAR">odd_count</field>
                <value name="VALUE">
                  <block type="math_number">
                    <field name="NUM">0</field>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>

        <!-- IF LOSS -->
        <statement name="ELSE">
          <block type="variables_set">
            <field name="VAR">stake</field>
            <value name="VALUE">
              <block type="math_arithmetic">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR">stake</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get">
                    <field name="VAR">martingale</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </statement>
      </block>

    </statement>
  </block>

</xml>
